# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or production credentials.

# Neon PostgreSQL.
# Runtime traffic: use the pooled endpoint (hostname includes "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER/DB?sslmode=require"

# Prisma CLI migrations: use the direct endpoint (hostname without "-pooler").
# prisma.config.ts prefers DIRECT_URL and falls back to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
CLERK_WEBHOOK_SECRET="whsec_replace_me"

# Cloudinary file storage
CLOUDINARY_CLOUD_NAME="replace_me"
CLOUDINARY_API_KEY="replace_me"
CLOUDINARY_API_SECRET="replace_me"

# Security: use long, randomly generated values kept server-side.
IP_HASH_PEPPER="replace_with_random_secret"
CRON_SECRET="replace_with_random_secret"

# Optional canonical public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: dedicated sandbox Clerk account for authenticated Playwright tests.
# Never use a personal or production account.
# E2E_TEST_EMAIL=""
# E2E_TEST_PASSWORD=""
